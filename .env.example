# Real Anthropic API key — only read by the credential proxy, never passed to workers
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override Anthropic upstream (e.g. for testing)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Telegram channel (optional — omit if not using Telegram)
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321  # comma-separated Telegram chat IDs

# MonoClaw data directory (default: ~/.monoclaw)
# MONOCLAW_DATA_DIR=/path/to/data
